# Production Environment Variables
# Copy to .env.prod and set actual values before deployment

# Server
PORT=8080
ENV=production

# Database (use strong passwords in production!)
DATABASE_URL=postgres://intent:YOUR_PROD_PASSWORD@postgres:5432/intent?sslmode=require

# Redis
REDIS_URL=redis://redis:6379

# Circle API (required for wallet + settlement)
CIRCLE_API_KEY=your_circle_production_api_key
